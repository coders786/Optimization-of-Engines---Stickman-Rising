 }
 densityKey(slot,t){const g=this.gl,p=this.density;slot.time=t;g.bindFramebuffer(g.FRAMEBUFFER,slot.density.fbo);g.viewport(0,0,slot.density.w,slot.density.h);g.useProgram(p.p);this.bind(0,this.noise);g.uniform1i(p.u.u_noiseTex,0);g.uniform1f(p.u.u_time,t);g.uniform1f(p.u.u_aspect,state.w/state.h);g.uniform1i(p.u.u_pack,this.floatTargets?0:1);g.drawArrays(g.TRIANGLES,0,3);}
 mediaKey(slot,mx,my){const g=this.gl,p=this.media;g.bindFramebuffer(g.FRAMEBUFFER,slot.media.fbo);g.viewport(0,0,slot.media.w,slot.media.h);g.useProgram(p.p);this.bind(0,slot.density.tex);g.uniform1i(p.u.u_density,0);g.uniform2f(p.u.u_densityDecode,1,this.floatTargets?0:1/255);g.uniform2f(p.u.u_moonCloud,mx,my);g.uniform1f(p.u.u_aspect,state.w/state.h);g.uniform1f(p.u.u_rayIntensity,state.rayIntensity);g.uniform1i(p.u.u_pack,this.floatTargets?0:1);g.drawArrays(g.TRIANGLES,0,3);}
 updateKeys(t,mx,my){const g=this.gl,step=1/state.cacheHz;g.disable(g.SCISSOR_TEST);if(!this.cacheValid||t<this.a.time||t-this.b.time>step*2){this.densityKey(this.a,t);this.densityKey(this.b,t+step);this.mediaKey(this.a,mx,my);this.mediaKey(this.b,mx,my);this.cacheValid=true;this.keyMX=mx;this.keyMY=my;this.keyRay=state.rayIntensity;}else{let turns=0;while(t>=this.b.time&&turns++<3){const temp=this.a;this.a=this.b;this.b=temp;this.densityKey(this.b,this.a.time+step);this.mediaKey(this.b,mx,my);}/* User edits invalidate lighting immediately; density keys remain reusable. */if(state.draggingMoon||Math.abs(mx-this.keyMX)+Math.abs(my-this.keyMY)>.00035||this.keyRay!==state.rayIntensity){this.mediaKey(this.a,mx,my);this.mediaKey(this.b,mx,my);this.keyMX=mx;this.keyMY=my;this.keyRay=state.rayIntensity;}}
 this.blend=Math.max(0,Math.min(1,(t-this.a.time)/(this.b.time-this.a.time)));
 }
 beginTiming(){const g=this.gl;this.activeQuery=null;if(!this.extTimer)return;if((this.queryFrame++&7)===0){for(const q of this.queries)if(q.pending&&g.getQueryParameter(q.q,g.QUERY_RESULT_AVAILABLE)){const bad=g.getParameter(this.extTimer.GPU_DISJOINT_EXT);if(!bad){const ms=g.getQueryParameter(q.q,g.QUERY_RESULT)/1e6;this.gpuMs=this.gpuMs?this.gpuMs*.8+ms*.2:ms;}q.pending=false;break;}}for(let i=0;i<this.queries.length;i++){const q=this.queries[this.queryCursor++%this.queries.length];if(!q.pending){g.beginQuery(this.extTimer.TIME_ELAPSED_EXT,q.q);this.activeQuery=q;break;}}}
 endTiming(){if(this.activeQuery){this.gl.endQuery(this.extTimer.TIME_ELAPSED_EXT);this.activeQuery.pending=true;this.activeQuery=null;}}
 common(p,t,mx,my){const g=this.gl,u=p.u;g.useProgram(p.p);g.uniform1f(u.u_time,t);g.uniform2f(u.u_camShift,state.camNX,state.camNY);g.uniform2f(u.u_moonScr,mx,my);g.uniform1f(u.u_flicker,state.flicker);g.uniform1f(u.u_rayIntensity,state.rayIntensity);g.uniform1f(u.u_doorCenter,geo.cabX);g.uniform2f(u.u_doorWindow,geo.door0,geo.door1);g.uniform1f(u.u_cacheBlend,this.blend);}
 render(t){const g=this.gl,breath=1+.008*Math.sin(t*.45),mx=.5+(state.moonX-.5)*breath,my=.5+(state.moonY-.5)*breath;this.beginTiming();g.bindVertexArray(this.vao);this.updateKeys(t,mx+state.camNX*.04,my+state.camNY*.04);g.bindFramebuffer(g.FRAMEBUFFER,null);g.viewport(0,0,deck.width,deck.height);this.bind(0,this.occluder);if(occDirty){g.pixelStorei(g.UNPACK_FLIP_Y_WEBGL,false);g.pixelStorei(g.UNPACK_PREMULTIPLY_ALPHA_WEBGL,true);g.texSubImage2D(g.TEXTURE_2D,0,0,0,g.RGBA,g.UNSIGNED_BYTE,occCanvas);g.pixelStorei(g.UNPACK_PREMULTIPLY_ALPHA_WEBGL,false);occDirty=false;}this.bind(1,this.noise);this.bind(2,this.a.density.tex);this.bind(3,this.b.density.tex);this.bind(4,this.a.media.tex);this.bind(5,this.b.media.tex);
  const rows=Math.max(0,Math.min(deck.height,Math.round((1-HY+state.camNY*.72)*deck.height)));g.enable(g.SCISSOR_TEST);g.scissor(0,rows,deck.width,deck.height-rows);this.common(this.sky,t,mx,my);g.drawArrays(g.TRIANGLES,0,3);
  g.scissor(0,0,deck.width,rows);this.common(this.deck,t,mx,my);const u=this.deck.u;updateShadowBounds(mx+state.camNX*.64,my+state.camNY*.64);g.uniform4fv(u['u_shadowAABB[0]'],state.shadow);if(this.lastRipple!==state.rippleVersion){g.uniform4fv(u['u_ripples[0]'],state.ripples);this.lastRipple=state.rippleVersion;}
  let lx=mx+state.camNX*.64-.5,ly=.65,lz=-.45,len=Math.hypot(lx,ly,lz);lx/=len;ly/=len;lz/=len;g.uniform3f(u.u_moonDir,lx,ly,lz);const vl=Math.hypot(.68,.88),vy=.68/vl,vz=.88/vl;let hx=lx,hy=ly+vy,hz=lz+vz;len=Math.hypot(hx,hy,hz);hx/=len;hy/=len;hz/=len;g.uniform3f(u.u_halfVec,hx,hy,hz);const f=1-Math.max(0,hy*vy+hz*vz);g.uniform1f(u.u_specF,.04+.96*f*f*f*f*f);let rx=mx+state.camNX*.64-.64,ry=.55,rz=-.5;len=Math.hypot(rx,ry,rz);g.uniform3f(u.u_reflDir,rx/len,ry/len,rz/len);g.drawArrays(g.TRIANGLES,0,3);g.disable(g.SCISSOR_TEST);this.endTiming();
 }
}
function updateShadowBounds(mx,my){const rtY=Math.max(.24,(HY-my)*1.65),g=geo,u=state.u;const casters=[[.265,.390,.245],[g.cabX-g.cabW*.65,g.cabX+g.cabW*.65,Math.max(.14,g.cabH+g.roofH)],[g.chX-.15*u/state.w,g.chX+.15*u/state.w,Math.max(.238,.26*u/state.h)]];for(let i=0;i<3;i++){const a=casters[i],t=Math.min(.82,a[2]/rtY),z=Math.min(.39,1.05*t/Math.max(.18,1-t)),k=.85*t,inv=1/Math.max(.18,1-k),pad=.025+.042*z*state.rayIntensity,x0=(a[0]-k*mx)*inv,x1=(a[1]-k*mx)*inv;state.shadow[i*4]=Math.min(a[0],x0)-pad;state.shadow[i*4+1]=Math.max(a[1],x1)+pad;state.shadow[i*4+2]=0;state.shadow[i*4+3]=z+pad;}}
function initGL(){try{gl=deck.getContext('webgl2',{alpha:true,antialias:false,depth:false,stencil:false,premultipliedAlpha:true,preserveDrawingBuffer:false,desynchronized:true,powerPreference:'high-performance'});if(!gl)throw new Error('WebGL2 unavailable');renderer=new Renderer(gl);deck.hidden=false;fallback.hidden=true;}catch(e){console.warn('Using Canvas fallback:',e);renderer=null;deck.hidden=true;fallback.hidden=false;}}
function renderFallback(){const c=ctx2(fallback),w=state.w,h=state.h,hy=(HY-state.camNY*.72)*h,r=state.dpr;c.setTransform(r,0,0,r,0,0);c.clearRect(0,0,w,h);const g=c.createLinearGradient(0,hy,0,h);g.addColorStop(0,'#283440');g.addColorStop(1,'#080d12');c.fillStyle=g;c.fillRect(0,hy,w,h-hy);c.strokeStyle='rgba(1,3,6,.85)';c.lineWidth=1.5;for(let i=-18;i<=18;i++){const x=VPX+i/29;c.beginPath();c.moveTo((x-state.camNX*.72)*w,hy);c.lineTo((VPX+(x-VPX)*1.65-state.camNX*1.58)*w,h);c.stroke();}const p=1/(1-.107),px=(VPX+(.636-VPX)*p-state.camNX*(.72+(p-1)*1.48))*w,py=hy+(p-1)*(HY-VPY)*h;c.save();c.translate(px,py);c.scale(1,.55);radial(c,0,0,.036*w,[[0,'rgba(225,240,250,.75)'],[.45,'rgba(95,148,181,.42)'],[1,'rgba(9,20,34,0)']]);c.restore();}
