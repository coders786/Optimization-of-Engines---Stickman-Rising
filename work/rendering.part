 target(w,h,density){const g=this.gl;let internal=this.floatTargets?(density?g.R16F:g.RGBA16F):g.RGBA8,format=this.floatTargets?(density?g.RED:g.RGBA):g.RGBA,type=this.floatTargets?g.HALF_FLOAT:g.UNSIGNED_BYTE,t=this.texture(w,h,internal,format,type),f=g.createFramebuffer();g.bindFramebuffer(g.FRAMEBUFFER,f);g.framebufferTexture2D(g.FRAMEBUFFER,g.COLOR_ATTACHMENT0,g.TEXTURE_2D,t,0);if(g.checkFramebufferStatus(g.FRAMEBUFFER)!==g.FRAMEBUFFER_COMPLETE){g.deleteFramebuffer(f);g.deleteTexture(t);throw new Error('Lightfield framebuffer unavailable');}return {tex:t,fbo:f,w,h};}
 bind(unit,t){const g=this.gl;g.activeTexture(g.TEXTURE0+unit);g.bindTexture(g.TEXTURE_2D,t);}
 resize(){const g=this.gl;g.bindFramebuffer(g.FRAMEBUFFER,null);for(const t of this.targets){g.deleteFramebuffer(t.fbo);g.deleteTexture(t.tex);}this.targets.length=0;const high=state.perfMode==='high',factor=high?1.25:1;const dw=Math.min(this.maxTex,Math.max(512,Math.ceil(state.w/state.h*640*factor/32)*32)),dh=Math.min(this.maxTex,Math.round(384*factor)),mw=Math.max(256,Math.round(dw*(high?.85:.75))),mh=Math.round(dh*(high?.85:.75));
  const make=()=>{const a=this.target(dw,dh,true),b=this.target(mw,mh,false);this.targets.push(a,b);return {density:a,media:b,time:0};};
  try{this.a=make();this.b=make();}catch(e){for(const t of this.targets){g.deleteFramebuffer(t.fbo);g.deleteTexture(t.tex);}this.targets.length=0;if(!this.floatTargets)throw e;this.floatTargets=false;this.a=make();this.b=make();}
  g.bindFramebuffer(g.FRAMEBUFFER,null);if(this.occluder)g.deleteTexture(this.occluder);this.occW=occCanvas.width;this.occH=occCanvas.height;this.occluder=this.texture(this.occW,this.occH,g.RGBA8,g.RGBA,g.UNSIGNED_BYTE);occDirty=true;this.cacheValid=false;this.lastRipple=-1;
  for(const p of [this.sky,this.deck]){g.useProgram(p.p);const u=p.u;g.uniform1i(u.u_occluderTex,0);g.uniform1i(u.u_noiseTex,1);g.uniform1i(u.u_density0,2);g.uniform1i(u.u_density1,3);g.uniform1i(u.u_media0,4);g.uniform1i(u.u_media1,5);g.uniform2f(u.u_densityDecode,1,this.floatTargets?0:1/255);g.uniform1i(u.u_mediaPacked,this.floatTargets?0:1);g.uniform1f(u.u_aspect,state.w/state.h);}
